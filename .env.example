# ==========================================
# FOREX & GOLD SMC SCANNER - CONFIGURATION
# ==========================================

# 1. Telegram Bot Settings
TELEGRAM_BOT_TOKEN=twoj_token_z_botfather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx,123456789

# 2. MetaTrader 5 Settings
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# 3. Instrumenty do skanowania
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,USDCHF

# 4. Interwały czasowe
HTF_TIMEFRAME=H4
LTF_TIMEFRAME=M15
# Przesunięcie strefy czasowej brokera MT5 względem UTC w godzinach (np. EET = 2, EEST = 3)
BROKER_UTC_OFFSET_HOURS=2

# 5. Zarządzanie Ryzykiem (% kapitału na jedno wejście)
DEFAULT_RISK_PERCENT=1.0
DEFAULT_RR_RATIO=2.0

# 6. Adaptacyjny Best RR (automatyczne dopasowanie do statystyk dziennika)
USE_OPTIMAL_RR=True
MIN_TRADES_FOR_OPTIMAL_RR=5

# 7. Częstotliwość skanowania & Koniunkcja
SCAN_INTERVAL_SECONDS=60
TRADE_MONITOR_INTERVAL_SECONDS=15
MIN_CONFLUENCE_SCORE=70
BLOCK_ON_HIGH_IMPACT_NEWS=False
NEWS_WINDOW_MINUTES=45

# 8. Wybór Strategii (Opcja 3: Hybryda - SMC + Zumiko KillMLM)
ENABLE_SMC_STRATEGY=True
ENABLE_ZUMIKO_STRATEGY=True
ZUMIKO_FAST_EMA=10
ZUMIKO_SLOW_EMA=21
ZUMIKO_TREND_EMA=238
ZUMIKO_SWING_LEN=10
ZUMIKO_REQUIRE_H1=True

# 9. PROP FIRM SETTINGS
PROP_FIRM_MODE=True
PROP_INITIAL_BALANCE=600.0
PROP_MAX_DRAWDOWN_PERCENT=10.0
PROP_SAFETY_BUFFER_PERCENT=7.5
PROP_RISK_PER_TRADE_PERCENT=0.5
PROP_MAX_OPEN_TRADES=6
PROP_MAX_SAME_CURRENCY_TRADES=2
PROP_ENFORCE_NEWS_FILTER=True

# 10. SCALABLE RISK & TIGHT SL MANAGEMENT
TIGHT_SL_MODE=True
MAX_RISK_DEVIATION_TOLERANCE=1.35
AUTO_BE_AT_1R=True
AUTO_BE_OFFSET_PIPS=5.0
ADD_SPREAD_TO_SL=True
DEFAULT_SPREAD_PIPS=1.0
SL_CALCULATION_MODE=HYBRID
SL_ATR_MULTIPLIER=1.5
SL_HYBRID_MIN_ATR_MULT=0.8

# 11. ANTI-SPAM & ALERT COOLDOWN
ALERT_COOLDOWN_MINUTES=30
DISMISS_MUTE_HOURS=2.0

# 12. NOTION TRADE JOURNAL INTEGRATION
ENABLE_NOTION=False
NOTION_API_KEY=secret_twoj_notion_integration_token
NOTION_DATABASE_ID=twoj_32_znakowy_database_id

# 12. RISK-NEUTRAL PYRAMIDING SETTINGS (SCALE-IN)
ENABLE_PYRAMIDING=True
MAX_PYRAMID_LEVEL=2
PYRAMID_MIN_PROFIT_R=1.0
PYRAMID_LOCK_PREVIOUS_PROFIT=True
