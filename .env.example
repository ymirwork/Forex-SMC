# ==============================================================================
# FOREX & GOLD SMC SCANNER - REFERENCYJNA KONFIGURACJA (.env.example)
# ==============================================================================
# UWAGA: Kazda zmienna w tym pliku posiada dokladne wyjasnienie funkcjonalnosci,
# dopuszczalnych wartosci i jednostek, aby umozliwic bezproblemowa konfiguracje
# po dowolnie dlugiej przerwie ("Year-Later Readiness").
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Settings (Komunikacja i Alerty Mobilne)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=twoj_token_z_botfather # Prywatny token bota wygenerowany w Telegramie przez @BotFather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx,123456789 # Dozwolone ID czatow/kanalow oddzielone przecinkami (ujemne dla grup/kanalow)

# ------------------------------------------------------------------------------
# 2. MetaTrader 5 Settings (Polaczenie z Terminalem Brokera)
# ------------------------------------------------------------------------------
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe # Sciezka do pliku wykonywalnego terminala MetaTrader 5 na dysku
MT5_LOGIN=0 # Opcjonalny numer konta MT5 (0 = uzyj aktywnego/domyslnego profilu w otwartym terminalu)
MT5_PASSWORD= # Opcjonalne haslo do konta inwestycyjnego MT5
MT5_SERVER= # Opcjonalna nazwa serwera brokera MT5 (np. "ICMarketsSC-Demo")

# ------------------------------------------------------------------------------
# 3. Instrumenty do skanowania (Rynek)
# ------------------------------------------------------------------------------
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,USDCHF # Lista par walutowych i surowcow monitorowanych przez skaner

# ------------------------------------------------------------------------------
# 4. Interwaly Czasowe i Strefa Czasowa Brokera
# ------------------------------------------------------------------------------
HTF_TIMEFRAME=H4 # Wyzszy interwal (HTF) do analizy struktury nadrzednej i glownych stref (H4 lub D1)
LTF_TIMEFRAME=M15 # Nizszy interwal (LTF) do egzekucji, formacji wejscia i konfluencji (M15 lub M5)
BROKER_UTC_OFFSET_HOURS=2 # Przesuniecie strefy czasowej serwera MT5 wzgledem UTC w godzinach (np. EET = 2, EEST = 3)

# ------------------------------------------------------------------------------
# 5. Podstawowe Zarzadzanie Ryzykiem (Risk Management)
# ------------------------------------------------------------------------------
DEFAULT_RISK_PERCENT=1.0 # Domyslny procent kapitalu ryzykowany na pojedyncza transakcje (1.0 = 1%)
MAX_RISK_PERCENT=2.0 # Maksymalny twardy limit ryzyka na pozycje, blokujacy przypadkowe przewalutowanie
DEFAULT_RR_RATIO=2.0 # Domyslny bazowy stosunek Zysku do Ryzyka (Risk:Reward, np. 2.0 = 1:2)

# ------------------------------------------------------------------------------
# 6. Adaptacyjny Best RR i Ochrona Nocna (MFE Optimizer & Rollover)
# ------------------------------------------------------------------------------
USE_OPTIMAL_RR=True # Uzywanie optymalnego RR (dynamiczne wyliczanie Take Profit z MFE na podstawie historii trades.db)
MIN_TRADES_FOR_OPTIMAL_RR=30 # Minimalna liczba transakcji w bazie danych przed aktywacja statystycznego Best RR
OPTIMAL_RR_MIN_FLOOR=2.0 # Twarde minimalne RR (Take Profit nigdy nie zostanie wyznaczony ponizej 2.0R)
BLOCK_ROLLOVER_SESSION=True # Blokowanie skanowania i nowych wejsc podczas wieczornej sesji low-liquidity (20:00 - 00:00 UTC)
ENABLE_ROLLOVER_SL_SHIELD=True # Aktywna ochrona otwartych pozycji przed skokiem spreadu na zamknieciu dnia MT5 (23:40 - 00:30 czasu serwera)
ROLLOVER_SHIELD_START_MINUTES=20 # Ile minut przed zamknieciem swiecy D1 (23:40 czasu MT5) wlaczyc ochrone SL
ROLLOVER_SHIELD_END_MINUTES=30 # Ile minut po rozpoczeciu nowego dnia (00:30 czasu MT5) utrzymac ochrone SL
ROLLOVER_DISASTER_SL_R=2.5 # Odleglosc awaryjnego Disaster SL (w wielokrotnosciach R) chroniaca przed czarna labedzia
ROLLOVER_MAX_SPREAD_MULT=1.5 # Mnoznik normalnego spreadu, ponizej ktorego uznajemy spread za ustabilizowany
ROLLOVER_MAX_SPREAD_PIPS=3.0 # Maksymalny prog spreadu w pipsach dla par walutowych umozliwiajacy zdjecie oslony
ROLLOVER_MAX_SPREAD_GOLD_PIPS=25.0 # Maksymalny prog spreadu w pipsach dla zlota XAUUSD ($2.50) umozliwiajacy zdjecie oslony
MAX_SL_ATR_MULTIPLIER=2.5 # Maksymalny dozwolony rozmiar Stop Lossa wyrazony wielokrotnoscia ATR (filtr zbyt szerokich stopow)
REQUIRE_STRUCTURAL_SPACE_FOR_RR=True # Odrzucanie setupu, jesli wazna przeszkoda strukturalna ogranicza przestrzen ponizej 2.0R

# ==========================================
# ADVANCED SMC & SMART RISK SETTINGS (Mentoring Smart Risk)
# ==========================================
ENFORCE_STRONG_STRUCTURAL_SL=True # SL chroniony ZAWSZE za Strong Low / Strong High, eliminacja wybic na losowych knotach
REQUIRE_SWEEP_ENGINEERED_OB=False # Jesli True, akceptuje tylko Order Blocki powstake w wyniku uprzedniego sweepu (Hack #2)
BONUS_POINTS_SWEEP_OB=15          # Punkty bonusowe dla setupu opartego o Sweep-Engineered OB (+15%)
ENABLE_ROOM_TO_RUN_HTF_FILTER=True # Odrzuca trade, jesli na drodze do TP stoi swieza przeciwna strefa H1/H4 (Hack #1 & #5)
ROOM_TO_RUN_HTF_MIN_RR=1.5        # Minimalna wolna przestrzen (w R) do przeciwleglej strefy H1/H4 S/D

# ------------------------------------------------------------------------------
# 7. Czestotliwosc Skanowania i Filtry Newsow
# ------------------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=60 # Co ile sekund skaner analizuje rynek i poszukuje nowych formacji
TRADE_MONITOR_INTERVAL_SECONDS=15 # Co ile sekund monitor pozycji sprawdza warunki Auto-BE, piramidowania i rolloveru
SWING_LENGTH=5 # Liczba swiec z lewej i prawej strony definiujaca lokalny punkt zwrotny (Swing Pivot)
LOOKBACK_BARS=300 # Liczba swiec historycznych pobierana z MT5 do analizy struktury rynku
MIN_CONFLUENCE_SCORE=70 # Minimalny wymagany wynik konfluencji setupu (0-100%), aby wyslac alert do tradera
BLOCK_ON_HIGH_IMPACT_NEWS=False # Blokowanie handlu podczas publikacji najwazniejszych danych makro (czerwone teczki)
NEWS_WINDOW_MINUTES=45 # Czas w minutach przed i po publikacji newsa, w ktorym transakcje sa wstrzymane

# ------------------------------------------------------------------------------
# 8. Strategie Detekcji (SMC + Zumiko KillMLM)
# ------------------------------------------------------------------------------
ENABLE_SMC_STRATEGY=True # Wlaczenie silnika Smart Money Concepts (BOS, CHoCH, Order Block, FVG, Fibo OTE)
ENABLE_ZUMIKO_STRATEGY=True # Wlaczenie silnika trendowego Zumiko KillMLM (EMA 9/21/238 + VWAP + POC + Higher Lows / Lower Highs)
ZUMIKO_FAST_EMA=9 # Okres szybkiej sredniej EMA do oceny dynamiki momentum (oficjalnie EMA 9 wg PDF)
ZUMIKO_SLOW_EMA=21 # Okres wolnej sredniej EMA wyznaczajacej lokalny korytarz trendowy (Ribbon)
ZUMIKO_TREND_EMA=238 # Okres nadrzednej sredniej trendowej EMA (Cena powyzej = tylko BUY, ponizej = tylko SELL)
ZUMIKO_SWING_LEN=10 # Dlugosc swiec do potwierdzania struktury dolkow i szczytow w Zumiko
ZUMIKO_REQUIRE_H1=True # Wymog potwierdzenia kierunku setupu przez strukture wyzszego interwalu H1
ZUMIKO_REQUIRE_VWAP_ALIGNMENT=True # Wymog zgodnosci ceny z poziomem VWAP (BUY tylko nad VWAP, SELL tylko pod VWAP)
ZUMIKO_RSI_MAX_BUY=75.0 # Maksymalna dopuszczalna wartosc RSI dla BUY (ochrona przed wejsciem na skrajnym wykupieniu)
ZUMIKO_RSI_MIN_SELL=25.0 # Minimalna dopuszczalna wartosc RSI dla SELL (ochrona przed wejsciem na skrajnym wyprzedaniu)
ZUMIKO_USE_HEIKIN_ASHI_FILTER=True # Weryfikacja jakosci impetu za pomoca wygladzonych swiec Heikin-Ashi i odrzucenia knotow
ZUMIKO_ENABLE_POC_TARGETING=True # Wyznaczanie poziomu Point of Control (POC) jako celu TP lub magnesu reakcji

# ------------------------------------------------------------------------------
# 9. Reguly Kont Fundowanych (Prop Firm Settings)
# ------------------------------------------------------------------------------
PROP_FIRM_MODE=True # Wlaczenie twardych regul bezpieczenstwa kont prop tradingowych (drawdown, limity par)
PROP_INITIAL_BALANCE=600.0 # Poczatkowy kapital konta uzywany jako baza do kalkulacji statycznego drawdownu
PROP_MAX_DRAWDOWN_PERCENT=10.0 # Maksymalny dopuszczalny statyczny spadek kapitalu konta w % (np. 10% = $540 przy $600)
PROP_SAFETY_BUFFER_PERCENT=7.5 # Bufor bezpieczenstwa: wstrzymanie nowych pozycji przy stracie 7.5% (ochrona przed 10% DD)
PROP_RISK_PER_TRADE_PERCENT=0.5 # Procent ryzyka na pojedyncza transakcje w trybie Prop Firm (0.5% dla ochrony kapitalu)
PROP_MAX_OPEN_TRADES=6 # Maksymalna dopuszczalna liczba jednoczesnie otwartych transakcji na calym koncie
PROP_MAX_SAME_CURRENCY_TRADES=2 # Maksymalna liczba jednoczesnych transakcji obciazajacych te sama walute bazowa/kwotowana
PROP_ENFORCE_NEWS_FILTER=True # Twardy zakaz otwierania pozycji w trakcie newsow High-Impact na kontach Prop

# ------------------------------------------------------------------------------
# 10. Skalowalne Zarzadzanie Ryzykiem i Stop Loss (Risk & SL Management)
# ------------------------------------------------------------------------------
TIGHT_SL_MODE=True # Ciasny Stop Loss wyznaczany dokladnie za knotem reakcyjnym lub krawedzia strefy OTE
MAX_RISK_DEVIATION_TOLERANCE=1.35 # Dopuszczalne odchylenie ryzyka przy zaokragleniu do min. lota 0.01 (1.35 = max +35%)
AUTO_BE_AT_1R=True # Automatyczne przestawianie zlecenia na Break-Even po osiagnieciu zysku
AUTO_BE_R_TRIGGER=0.85 # Poziom zysku w R (np. +0.85R), po ktorym Stop Loss jest przesuwany w strone zysku
AUTO_BE_OFFSET_PIPS=0.2 # Dodatkowy zysk w pipsach dodawany do Break-Even na pokrycie prowizji brokera
ADD_SPREAD_TO_SL=True # Dodawanie aktualnego spreadu do dystansu SL (zapobiega przypadkowemu wybiciu knotem ask)
DEFAULT_SPREAD_PIPS=1.0 # Domyslna wartosc spreadu w pipsach uzywana w przypadku braku odczytu z MT5
SL_CALCULATION_MODE=HYBRID # Algorytm wyliczania SL: HYBRID (struktura + margines ATR), STRUCTURE lub ATR
SL_ATR_MULTIPLIER=1.5 # Mnoznik wskaznika ATR(14) przy wyliczaniu Stop Lossa w trybie ATR
SL_HYBRID_MIN_ATR_MULT=1.2 # Minimalny bufor bezpieczenstwa ATR w trybie HYBRID
MIN_SL_PIPS_FOREX=14.0 # Minimalny dopuszczalny Stop Loss w pipsach dla par glownych Forex (filtr mikro-stopow)
MIN_SL_PIPS_CROSS_JPY=18.0 # Minimalny dopuszczalny Stop Loss w pipsach dla par z jenem japonskim JPY
MIN_SL_PIPS_GBP=20.0 # Minimalny dopuszczalny Stop Loss w pipsach dla wysoce zmiennych par z funtem GBP
MIN_SL_PIPS_GOLD=300.0 # Minimalny dopuszczalny Stop Loss w pipsach dla zlota XAUUSD (300 pips = $30.00)
REQUIRE_REJECTION_CANDLE=True # Wymog wystapienia potwierdzenia swiecowego (rejection wick lub zgodne zamkniecie)
REJECTION_WICK_MIN_RATIO=0.25 # Minimalny stosunek dlugosci knota odrzucenia do calkowitej rozpietosci swiecy (25%)
BLOCK_EVENING_ENTRIES=True # Blokowanie nowych zlecen w godzinach wieczornych (spadek plynnosci po zamknieciu Londynu)
EVENING_BLOCK_START_HOUR_UTC=17 # Godzina poczatkowa blokady wieczornej w UTC (17:00 UTC = 18:00 CET / 19:00 MT5)
EVENING_BLOCK_END_HOUR_UTC=23 # Godzina koncowa blokady wieczornej w UTC (23:00 UTC = 00:00 CET / 01:00 MT5)

# ------------------------------------------------------------------------------
# 11. Ochrona Przed Spamem i Wyciszanie Alertow (Anti-Spam & Cooldown)
# ------------------------------------------------------------------------------
ALERT_COOLDOWN_MINUTES=30 # Czas w minutach blokujacy powtorne wysylanie tego samego alertu na tej samej parze
DISMISS_MUTE_HOURS=2.0 # Liczba godzin calkowitego wyciszenia instrumentu po kliknieciu przycisku 'Pomin' w Telegramie

# ------------------------------------------------------------------------------
# 12. Cyfrowy Dziennik Transakcji Notion (Notion Trade Journal)
# ------------------------------------------------------------------------------
ENABLE_NOTION=False # Czy transakcje maja byc automatycznie synchronizowane z baza Notion (False = tylko SQLite)
NOTION_API_KEY=secret_twoj_notion_integration_token # Prywatny token integracji Notion (Internal Integration Secret)
NOTION_DATABASE_ID=twoj_32_znakowy_database_id # 32-znakowy identyfikator bazy danych transakcji w Notion

# ------------------------------------------------------------------------------
# 13. Wielopoziomowe Piramidowanie Pozycji (Advanced Scale-In)
# ------------------------------------------------------------------------------
ENABLE_PYRAMIDING=True # Wlaczenie modulu piramidowania (dokladanie pozycji L2 i L3 do silnego trendu)
MAX_PYRAMID_LEVEL=3 # Maksymalny dozwolony poziom klastra transakcji (Poziom 1 = baza, 2 = dokladka L2, 3 = dokladka L3)
PYRAMID_EXECUTION_TIMEFRAME=M5 # Interwal szukania wejsc dla dokladek (hybrydowy M5 dla dokladek, M15 dla bazy)
PYRAMID_MIN_PROFIT_R=1.0 # Minimalny osiagniety zysk pozycji bazowej w R (+1.0R), zanim dozwolona bedzie dokladka
PYRAMID_MIN_RR_TO_TP=1.0 # Minimalna przestrzen Risk:Reward od ceny dokladki do Master TP (min. 1.0R dla M5)
PYRAMID_AUTO_EXECUTE=False # Automatyczna egzekucja dokladek (False = powiadomienie z interaktywnymi przyciskami na TG)
PYRAMID_MAX_RISK_FINANCE_RATIO=0.75 # Maksymalny procent zabezpieczonego zysku pozycji nadrzednej finansujacy dokladke (75%)
PYRAMID_ALLOW_MIN_LOT_FLOAT=True # Zezwolenie na minimalny lot 0.01 o ile ryzyko miesci sie w zablokowanym zysku
PYRAMID_LOCK_PREVIOUS_PROFIT=True # Twardy wymog trwalego zablokowania zysku z poprzedniej pozycji (SL powyzej Break-Even)

# ------------------------------------------------------------------------------
# 14. Detekcja Instytucjonalnych Poziomow Plynnosci (Liquidity Sweeps)
# ------------------------------------------------------------------------------
ENABLE_LIQUIDITY_DETECTOR=True # Wlaczenie modulu analizy sweepow plynnosci instytucjonalnej (BSL / SSL)
ENABLE_PDH_PDL_SWEEP=True # Wykrywanie sweepow szczytu i dolka z poprzedniego dnia (Previous Day High / Low)
ENABLE_PWH_PWL_SWEEP=True # Wykrywanie sweepow szczytu i dolka z poprzedniego tygodnia (Previous Week High / Low)
ENABLE_EQH_EQL_SWEEP=True # Wykrywanie sweepow podwojnych i potrojnych ekstremow (Equal Highs / Equal Lows)
ENABLE_ASIAN_SWEEP=True # Wykrywanie sweepow strefy plynnosci sesji azjatyckiej (Asian Range High / Low)
LIQUIDITY_SWEEP_LOOKBACK_BARS=15 # Liczba swiec wstecz analizowanych pod katem naruszenia i odrzucenia poziomu plynnosci
EQH_EQL_ATR_MULT=0.15 # Maksymalna tolerancja zbieznosci dwoch szczytow/dolkow w ulamku ATR, aby uznac je za rowne
EQH_EQL_MIN_BARS_DISTANCE=5 # Minimalny odstep w swiecach pomiedzy szczytami/dolkami tworzacymi strefy EQH/EQL

# ------------------------------------------------------------------------------
# 15. Statystyczny Silnik Badania Przewagi (Dynamic Trade Insights & Edge Filter)
# ------------------------------------------------------------------------------
ENABLE_DYNAMIC_EDGE_FILTER=True # Wlaczenie automatycznego dopasowywania ryzyka na podstawie historycznego Edge
DYNAMIC_FILTER_MODE=ADVISORY # Tryb filtru: ADVISORY (ostrzezenie i redukcja ryzyka o 50%) lub STRICT (calkowita blokada)
INSIGHTS_MIN_SAMPLE_SIZE=10 # Minimalna liczba transakcji dla danej pary/sesji, zanim nalozone zostana filtry
SEND_WEEKEND_INSIGHTS_REPORT=True # Automatyczna wysylka statystycznego raportu tygodniowego w niedziele przed otwarciem

# ------------------------------------------------------------------------------
# 16. Silnik Adaptacyjnego Zarzadzania Pozycjami (Adaptive Position Manager)
# ------------------------------------------------------------------------------
ENABLE_ADAPTIVE_MANAGER=True # Wlaczenie hybrydowego silnika adaptacyjnego (Rezymy rynku, Dynamic BE, Trailing M15)
ADAPTIVE_MODE=SHADOW # Tryb dzialania: SHADOW (bezpieczna rejestracja w logach/bazie) lub LIVE (realna modyfikacja w MT5)
ADAPTIVE_MIN_REGIME_SAMPLES=10 # Minimalna liczba historycznych transakcji w danym rezymie do aktywacji optymalizacji TP
ADAPTIVE_M15_TRAILING=True # Wlaczenie strukturalnego trailingu SL za potwierdzonymi dolkami/szczytami M15
ADAPTIVE_BE_TREND_R=1.15 # Poziom Break-Even w silnym trendzie (pozwala na swobodny pullback przed kontynuacja)
ADAPTIVE_BE_CHOP_R=0.80 # Poziom Break-Even w konsolidacji / szumie (szybkie zabezpieczenie kapitalu)
ADAPTIVE_BE_VOLATILE_R=0.85 # Poziom Break-Even przy podwyzszonej zmiennosci rynkowej
ADAPTIVE_TRAILING_MIN_STEP_R=0.40 # Minimalny krok zablokowanego zysku (w R) wymagany do przesuniecia SL
ADAPTIVE_TRAILING_ATR_MULT=1.0 # Minimalny bufor odleglosci nowego SL od biezacej ceny (mnoznik ATR M15)

